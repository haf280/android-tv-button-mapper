<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.nilava.tvrecents" android:versionCode="2" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- Which apps you used recently. You allow it once in Settings > Apps > Special app access > Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Android 11+ only shows apps that are asked for: TV apps, normal apps and home screens. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Recents" android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:noHistory="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetupActivity"
            android:exported="false" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <!-- Optional. You turn it on in Settings > Accessibility. -->
        <service android:name=".RecentsService" android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/recents_service" />
        </service>
    </application>
</manifest>
